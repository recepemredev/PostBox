# The single source of configuration for the whole stack.
#
# Compose reads this file twice: once to interpolate the topology (ports, database
# name) and once to hand the values to the containers. There is no second .env
# inside backend/ — the same value living in two files is how environments drift.
#
# Copy to .env (`task.ps1 up` / `make up` does it for you) and never commit it.

# --- Published ports --------------------------------------------------------
# The only port that has to be published is the single origin. The datastore
# ports are forwarded for local inspection and are not published in production.
HTTP_PORT=8080
DB_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379
MAILPIT_HTTP_PORT=8025

# --- Application ------------------------------------------------------------
APP_NAME=PostBox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# DB_HOST is the compose service name. The test suite runs against
# ${DB_DATABASE}_test, created when the data volume is first initialised.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=postbox
DB_USERNAME=postbox
DB_PASSWORD=postbox-local-password

# The application never connects as the owning role above. It connects as a role
# that owns nothing and holds neither SUPERUSER nor BYPASSRLS, so Row Level
# Security applies to it; the owning role is used by migrations alone. The role
# is created by the first migration, with this password.
DB_APP_USERNAME=postbox_app
DB_APP_PASSWORD=postbox-local-app-password

# --- Redis ------------------------------------------------------------------
# Queues, locks and rate-limit buckets. Redis is not optional infrastructure
# here: the delivery path depends on it.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=0

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Mail (development only) ------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=postbox@localhost
MAIL_FROM_NAME="${APP_NAME}"

# --- Ledger -------------------------------------------------------------
# How far ahead the scheduled partitions:ensure command keeps a monthly
# partition open, and how long each table keeps its partitions before they are
# dropped. Attempts are retained for a shorter window than messages: they are
# the higher-volume, more diagnostic of the two.
POSTBOX_PARTITION_MONTHS_AHEAD=3
POSTBOX_MESSAGE_RETENTION_MONTHS=6
POSTBOX_ATTEMPT_RETENTION_MONTHS=3

# --- Frontend ---------------------------------------------------------------
# Same origin: the browser talks to nginx, which routes /api to PHP-FPM. A
# cross-origin base URL here would mean cookies behave differently in
# development than in production, which is the thing nginx exists to prevent.
NEXT_PUBLIC_API_BASE_URL=/api
