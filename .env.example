# The single source of configuration for the whole stack.
#
# Compose reads this file twice: once to interpolate the topology (ports, database
# name) and once to hand the values to the containers. There is no second .env
# inside backend/ — the same value living in two files is how environments drift.
#
# Copy to .env (`task.ps1 up` / `make up` does it for you) and never commit it.

# --- Published ports --------------------------------------------------------
# The only port that has to be published is the single origin. The datastore
# ports are forwarded for local inspection and are not published in production.
HTTP_PORT=8080
DB_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379
MAILPIT_HTTP_PORT=8025

# --- Application ------------------------------------------------------------
APP_NAME=PostBox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# DB_HOST is the compose service name. The test suite runs against
# ${DB_DATABASE}_test, created when the data volume is first initialised.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=postbox
DB_USERNAME=postbox
DB_PASSWORD=postbox-local-password

# The application never connects as the owning role above. It connects as a role
# that owns nothing and holds neither SUPERUSER nor BYPASSRLS, so Row Level
# Security applies to it; the owning role is used by migrations alone. The role
# is created by the first migration, with this password.
DB_APP_USERNAME=postbox_app
DB_APP_PASSWORD=postbox-local-app-password

# --- Redis ------------------------------------------------------------------
# Queues, locks and rate-limit buckets. Redis is not optional infrastructure
# here: the delivery path depends on it.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=0

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Mail (development only) ------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=postbox@localhost
MAIL_FROM_NAME="${APP_NAME}"

# --- Ledger -------------------------------------------------------------
# How far ahead the scheduled partitions:ensure command keeps a monthly
# partition open, and how long each table keeps its partitions before they are
# dropped. Attempts are retained for a shorter window than messages: they are
# the higher-volume, more diagnostic of the two.
POSTBOX_PARTITION_MONTHS_AHEAD=3
POSTBOX_MESSAGE_RETENTION_MONTHS=6
POSTBOX_ATTEMPT_RETENTION_MONTHS=3

# --- Ingest -----------------------------------------------------------------
# How long a spent Idempotency-Key stays reserved. Past it the key is prunable
# and a replay produces a new message rather than the original. The payload
# ceiling is deliberately not here: the database holds the same figure as a
# CHECK constraint, so it is a literal in config/postbox.php.
POSTBOX_IDEMPOTENCY_TTL_HOURS=24

# How long a claimed delivery is held off the dispatcher's next pass, and how
# many it claims in one. The lease is what makes a worker that never ran cost
# latency instead of a lost delivery.
POSTBOX_OUTBOX_LEASE_SECONDS=300
POSTBOX_OUTBOX_BATCH_SIZE=500

# --- Delivery -----------------------------------------------------------
# The outbound transport's own timeouts. connect_timeout_ms bounds the TCP/TLS
# handshake; timeout_ms bounds the whole request, handshake included.
# horizon.php reads the total to size a worker's own timeout past it.
POSTBOX_DELIVERY_CONNECT_TIMEOUT_MS=5000
POSTBOX_DELIVERY_TIMEOUT_MS=15000

# How many worker processes each delivery-engine queue runs, per container.
# deliveries carries every live send; retries (Step 7) and maintenance
# (Step 8) are provisioned now and idle until those steps fill them.
HORIZON_DELIVERIES_PROCESSES=10
HORIZON_RETRIES_PROCESSES=5
HORIZON_MAINTENANCE_PROCESSES=2

# How far a signed request's timestamp may drift from the receiving clock
# before the signature is refused, in either direction.
POSTBOX_SIGNATURE_TOLERANCE_SECONDS=300

# --- Frontend ---------------------------------------------------------------
# Same origin: the browser talks to nginx, which routes /api to PHP-FPM. A
# cross-origin base URL here would mean cookies behave differently in
# development than in production, which is the thing nginx exists to prevent.
NEXT_PUBLIC_API_BASE_URL=/api
